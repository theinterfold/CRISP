{
  "name": "@crisp-e3/main",
  "private": true,
  "type": "module",
  "description": "CRISP - Coercion-Resistant Impartial Selection Protocol",
  "author": {
    "name": "gnosisguild",
    "url": "https://github.com/gnosisguild"
  },
  "scripts": {
    "compile": "forge compile",
    "cli": "bash ./scripts/cli.sh",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,md,mdx,ts,tsx,yml,yaml,css,sol}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,md,mdx,ts,tsx,yml,yaml,css,sol}\"",
    "dev:setup": "bash ./scripts/setup.sh",
    "dev:up": "bash ./scripts/dev.sh",
    "build:runner-image": "bash ./scripts/build-runner-image.sh",
    "test:e2e": "bash ./scripts/test_e2e.sh",
    "compile:contracts": "pnpm -C packages/crisp-contracts compile",
    "test:contracts": "pnpm -C packages/crisp-contracts test",
    "test:contracts:unit": "pnpm -C packages/crisp-contracts test:unit",
    "test:contracts:input-tree": "pnpm -C packages/crisp-contracts test:input-tree",
    "test:contracts:input-tree:poisoned-parent": "pnpm -C packages/crisp-contracts test:input-tree:poisoned-parent",
    "test:contracts:input-tree:canonical": "pnpm -C packages/crisp-contracts test:input-tree:canonical",
    "test:contracts:ballots:program": "pnpm -C packages/crisp-contracts test:ballots:program",
    "test:contracts:ballots:census": "pnpm -C packages/crisp-contracts test:ballots:census",
    "ciphernode:add": "pnpm -C packages/crisp-contracts ciphernode:add",
    "ciphernode:mint:tokens": "pnpm -C packages/crisp-contracts ciphernode:mint:tokens",
    "ciphernode:add:self": "pnpm -C packages/crisp-contracts ciphernode:add:self",
    "deploy:contracts": "pnpm -C packages/crisp-contracts deploy:contracts",
    "deploy:contracts:mock": "pnpm -C packages/crisp-contracts deploy:contracts:mock",
    "deploy:contracts:full": "pnpm -C packages/crisp-contracts deploy:contracts:full",
    "deploy:contracts:full:mock": "pnpm -C packages/crisp-contracts deploy:contracts:full:mock",
    "test": "pnpm test:e2e",
    "test:circuits": "cd circuits/lib && nargo test",
    "compile:circuits": "bash ./scripts/compile_circuits.sh",
    "compute:vk-hash": "bash ./scripts/compute_vk_hash.sh",
    "test:sdk": "pnpm -C packages/crisp-sdk test",
    "build:sdk": "pnpm -C packages/crisp-sdk build",
    "build:presets": "pnpm -C packages/crisp-sdk build:presets",
    "check:staged": "pnpm -C packages/crisp-sdk check:staged",
    "report": "playwright show-report",
    "publish:packages": "tsx scripts/publish.ts",
    "setup:testnet": "bash ./scripts/setup_testnet.sh",
    "openvm": "bash scripts/openvm.sh"
  },
  "devDependencies": {
    "@interfold/config": "0.20.0-dev.1",
    "eslint": "^9.39.1",
    "@playwright/test": "1.52.0",
    "@synthetixio/synpress": "4.1.1",
    "@synthetixio/synpress-cache": "0.0.13",
    "@types/node": "^22.18.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "playwright": "1.52.0",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.2.0",
    "typescript": "5.8.3",
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "overrides": {
      "@interfold/contracts>@openzeppelin/contracts-upgradeable": "5.0.2",
      "@nomicfoundation/hardhat-keystore": "3.0.3",
      "@types/node": "22.7.5",
      "tsup": "8.5.0",
      "typescript": "5.8.3",
      "undici-types": "6.19.8",
      "viem": "2.38.6"
    }
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808"
}
