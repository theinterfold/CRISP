# Private key for the interfold server
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Remote cron targets must use HTTPS. Use 127.0.0.1 (not 0.0.0.0) for local development.
INTERFOLD_SERVER_URL=http://127.0.0.1:4000
# Listener address. Unset, the server listens on 0.0.0.0:4000, which docker-compose needs to publish
# the port. Set loopback for a server outside Docker that does not need remote clients.
# CRISP_BIND_ADDR=127.0.0.1:4000
HTTP_RPC_URL=http://127.0.0.1:8545
PROGRAM_SERVER_URL=http://127.0.0.1:13151
WS_RPC_URL=ws://127.0.0.1:8545
CHAIN_ID=31337

# Etherscan API key
ETHERSCAN_API_KEY=""

# Cron-job API key to trigger new rounds
CRON_API_KEY=

# Interfold stack: updated automatically on each `pnpm dev:up` deploy (do not edit by hand unless debugging).
# Stale E3_PROGRAM_ADDRESS causes requestE3 to revert with empty data `0x`.
INTERFOLD_ADDRESS=0x0DCd1Bf9A1b36cE34237eEaFef220932846BCD82
FEE_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
E3_PROGRAM_ADDRESS=0xc351628EB244ec633d5f21fBD6621e1a683B1181
CIPHERNODE_REGISTRY_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
# CRISP voting eligibility token (MockVotingToken) — NOT the fee token above
CRISP_VOTING_TOKEN=0x5081a39b8A5f0E35a8D959395a630b68B74Dd30f

# Mock contracts registered on Interfold during deploy (reference only)
MOCK_COMPUTE_PROVIDER_ADDRESS=0x5eb3Bc0a489C5A8288765d2336659EbCA68FCd00
MOCK_DECRYPTION_VERIFIER_ADDRESS=0x36C02dA8a0983159322a80FFE9F24b1acfF8B570
MOCK_PK_VERIFIER_ADDRESS=0x809d550fca64d94Bd9F66E60752A544199cfAC3D
MOCK_E3_PROGRAM_ADDRESS=0x4c5859f0F772848b2D91F1D83E2Fe57935348029

# E3 Config
# Complete input window after the committee setup deadline. This includes voting and Avail
# finalization. In Avail mode, startup reads both windows from CRISPProgram and checks the sum.
# A one-hour vote plus a three-hour finalization window needs at least 14400 seconds.
E3_DURATION=300
# Time for the E3 request transaction to be mined before the voting window starts.
# This local example uses 20 seconds. The server default is 120 seconds.
VOTING_START_BUFFER_SECONDS=20

# Large encrypted objects use a deterministic in-process mock on local chains. Sepolia uses real
# Avail Turing: set `DATA_AVAILABILITY_MODE=avail`,
# `AVAIL_RPC_URL=https://turing-rpc.avail.so/rpc`,
# `AVAIL_BRIDGE_API_URL=https://turing-bridge-api.avail.so`, `AVAIL_APP_ID`, and `AVAIL_SEED`.
# A Sepolia program deployed with `MOCK_DATA_AVAILABILITY=true` keeps the mock instead: set
# `DATA_AVAILABILITY_MODE=mock` and `ALLOW_SEPOLIA_MOCK_DATA_AVAILABILITY=true`, and point the
# nodes at this server with `data_availability: { mode: mock_http, rpc_url: <server>/availability }`.
# On Sepolia, `PRIVATE_KEY` must be the key of the `INPUT_AVAILABILITY_SIGNER` address set in
# CRISPProgram. Sepolia accepts every OpenVM receipt because it uses `MockOpenVmReceiptVerifier`.
# For Ethereum mainnet use an HTTPS Avail RPC and `https://bridge-api.avail.so`.
DATA_AVAILABILITY_MODE=mock
ALLOW_SEPOLIA_MOCK_DATA_AVAILABILITY=
AVAIL_RPC_URL=
AVAIL_BRIDGE_API_URL=
AVAIL_APP_ID=
AVAIL_PROOF_LEAD_SECONDS=10800
# Refuse new unfinished publications before they can fill the server disk. Default: 1 GiB.
DATA_AVAILABILITY_MAX_PENDING_BYTES=1073741824
# Mock data availability only: bytes kept for the aggregate ciphertexts of other E3 programs on
# this Interfold, so nodes reading this server can fetch them. Their servers upload each output
# after `publishCiphertextOutput` with `PUT /availability/objects/<keccak256>?e3_id=<id>`. The
# server stores it only if Interfold holds that hash as the output of an E3 waiting for its
# decryption, and drops it after the decryption deadline. 0 (default) turns the route off.
EXTERNAL_OUTPUTS_MAX_BYTES=0
# Mock data availability only: the availability route of another CRISP server, for example
# `https://private-crisp.theinterfold.com/availability`. Once Interfold references this server's
# aggregate ciphertext, the server uploads the exact bytes to
# `PUT <url>/objects/0x<keccak256>?e3_id=<id>` (the route that EXTERNAL_OUTPUTS_MAX_BYTES enables
# there), after a restart too, and retries until the decryption deadline. A final refusal is logged
# as an error. Must be an http(s) URL without credentials, query or fragment. Empty uploads nothing.
EXTERNAL_OUTPUT_UPLOAD_URL=
# Avail secret URI for the server account that pays `submit_data`. Never commit a real value.
AVAIL_SEED=
# 0=InsecureThreshold64, 2=SecureThreshold8192
E3_PARAM_SET=0
# 0=Minimum, 1=Micro, 2=Small
E3_COMMITTEE_SIZE=0

# Input relay: the server sends `publishInput` for voters. Mainnet relays only with
# MAINNET_RELAY=true, which also needs RELAY_MAX_INPUTS_PER_ROUND and RELAY_MIN_BALANCE_ETH.
MAINNET_RELAY=false
# Relayed inputs per slot and per round for this server instance. Each instance counts only its
# own relays, so each relaying instance can send up to these limits with the shared server key.
# To keep one limit for the key, let one instance relay, set these limits to 0 on the others,
# send all client requests to the relaying instance, and move the relay only when no round is open.
# Past a limit, the voter's wallet sends the input. 0 turns the relay off.
# The server records its relays in database/server. A round that is already open when the server
# starts a new record (for example, with a new database) uses the voter's wallet for all inputs.
RELAY_MAX_INPUTS_PER_SLOT=3
RELAY_MAX_INPUTS_PER_ROUND=
# Stop relaying while the server key holds less than this ETH amount, to keep funds for
# finalizeInput. Required outside mainnet and local chains, where 0 means no floor.
# MAINNET_RELAY=true needs a value above zero.
RELAY_MIN_BALANCE_ETH=

# Program served by this instance: `crisp` (inputs on L1, the default) or `aztec` (inputs on Aztec;
# `E3_PROGRAM_ADDRESS` is then the CRISPAztecProgram). One instance serves one program. An Aztec
# instance relays nothing: set RELAY_MIN_BALANCE_ETH=0 off local chains. See
# ../extensions/aztec/README.md. `PRIVATE_KEY` must be the key of the availability signer that the
# Aztec contract stores.
PROGRAM_KIND=crisp
# Required for PROGRAM_KIND=aztec: the Aztec node, and the CrispAztec contract (32-byte address).
AZTEC_NODE_URL=
AZTEC_CONTRACT_ADDRESS=
# Seconds an input attestation stays valid, counted from the later of the Aztec and local clocks.
AZTEC_ATTESTATION_TTL_SECONDS=900
# First Aztec block to scan for inputs. Empty scans from the first block.
AZTEC_START_BLOCK=
# Required for PROGRAM_KIND=aztec: POST /voting/remote-input takes a staging pass, an anonymous proof that
# the sender holds the key of some slot of the round's census (extensions/core/circuits/staging_pass). The
# server verifies it with the Barretenberg CLI, which must be bb 6.0.0 (checked at startup), against this
# verification key. The Docker image sets all three.
STAGING_PASS_VK_PATH=
# bb 6.0.0; default `bb` on the PATH.
BB_BINARY_PATH=
# bb's reference-string directory; unset uses ~/.bb-crs and downloads it on the first verification.
BB_CRS_PATH=
# Passes one slot key may use per round: every staging, vote or mask, spends one. Default 16.
STAGING_MAX_REQUESTS_PER_SLOT=16

# PROGRAM_KIND=gnosis: inputs go to a CrispGnosisVoting contract on another EVM chain (Chiado). `PRIVATE_KEY`
# must be the contract's inputAvailabilitySigner and also pays the relay's `publishInput` there, so
# RELAY_MIN_BALANCE_ETH applies to its balance on that chain. `E3_PROGRAM_ADDRESS` is the CRISPGnosisProgram.
GNOSIS_RPC_URL=https://rpc.chiadochain.net
# The EIP-712 domain of the ballot and of the attestation; the chain id of GNOSIS_RPC_URL (checked at startup).
GNOSIS_CHAIN_ID=10200
# Required for PROGRAM_KIND=gnosis: the voting contract, the voting token, and the first block of the voting contract.
GNOSIS_VOTING_ADDRESS=
GNOSIS_TOKEN_ADDRESS=
GNOSIS_START_BLOCK=
# First block to read token logs from, for mask targets. Default GNOSIS_START_BLOCK.
GNOSIS_TOKEN_START_BLOCK=
# Seconds an attestation stays valid, counted from the later of the voting chain's and the local clock.
GNOSIS_ATTESTATION_TTL_SECONDS=3600
# Served by GET /voting/remote-input/config.
GNOSIS_EXPLORER_URL=https://gnosis-chiado.blockscout.com
# The Gnosis-chain RPC that GET /voting/remote-input/config hands to browsers as `rpc_url`. Keep API keys out of it:
# GNOSIS_RPC_URL stays server-side.
GNOSIS_PUBLIC_RPC_URL=https://rpc.chiadochain.net
# Priority fee in wei of the relay's and the faucet's transactions on the Gnosis chain, with a max fee of twice the latest
# base fee plus it. Unset, alloy's estimate applies, whose 1 gwei tip floor makes a relayed ballot (~3.2M gas) cost
# ~0.003 xDAI; Chiado includes transactions with a tip of a few wei.
GNOSIS_PRIORITY_FEE_WEI=
# POST /faucet mints the voting token with this key, which must be the token's `faucet`. It is not PRIVATE_KEY.
FAUCET_ENABLED=false
FAUCET_PRIVATE_KEY=
# Claims one IP address may make per day, on top of 3 a minute.
FAUCET_RATE_LIMIT_PER_IP_PER_DAY=5

# E3 Compute Provider Config
E3_COMPUTE_PROVIDER_NAME="OpenVM"
E3_COMPUTE_PROVIDER_PARALLEL=false
E3_COMPUTE_PROVIDER_BATCH_SIZE=4 # Must be a power of 2

# Whether to enable proof aggregation for E3 programs.
# Managed by pnpm dev:setup from ../crisp.dev.env — edit that file, then re-run dev:setup.
# See ../docs/PROOF_AGGREGATION_AND_ZK.md.

# --- Indexing / chain access -----------------------------------------------------------
# Block to start indexing from on a FRESH database. Absent = start at the chain head, which is
# what this server did before backfill existed. Ignored once a cursor is stored: a restart always
# resumes from the cursor and replays exactly the gap it missed.
#
# READ THIS BEFORE SETTING IT. Backfill replays through the SAME handlers as live events, and the
# E3 handlers are not pure — `E3Requested` submits `setMerkleRoot` on chain. Setting this to a
# deployment block on a fresh database therefore re-runs those side effects for every historical
# round, not just rebuilds an index. Most of those transactions will revert as already-applied,
# but they cost gas and they are broadcast from the server key.
#
# Safe uses:
#   - Leave unset in normal operation. The log index then starts at first boot, and queries for
#     earlier blocks are forwarded upstream, which is correct if slower.
#   - Set it on a deliberately fresh database when you want history AND accept the replay, ideally
#     with the relay key drained first.
# INDEX_START_BLOCK=

# eth_getLogs window used for backfill. Lower it if the provider rejects the range.
# INDEX_CHUNK_SIZE=2000

# Comma-separated contracts the read-only /chain/* routes will serve. EMPTY DENIES EVERYTHING:
# a misconfigured deployment must fail closed rather than become an open RPC endpoint. List every
# contract the frontend reads (coordinator, CRISP program, registries, refund manager, tokens,
# faucet, plugins, SPPs, DAO).
# INDEX_CONTRACTS=0x...,0x...

# Subset of the above whose LOGS are indexed into the store. Serving reads for a contract is
# cheap; retaining every log it emits is not — a busy ERC-20 emits thousands of Transfers per
# thousand blocks, and nothing queries them. List only contracts whose event history is actually
# read (plugins, SPPs, registries). Empty = no log indexing; queries still work, just forwarded.
# INDEX_LOG_CONTRACTS=0x...,0x...
