    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@crisp-e3/aztec": "workspace:*",
    "viem": "2.38.6"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vitest": "^1.6.1"
  }
