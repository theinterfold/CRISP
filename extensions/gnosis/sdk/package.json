{
  "name": "@crisp-e3/gnosis",
  "version": "0.28.1",
  "private": true,
  "type": "module",
  "description": "Client for CRISP rounds that collect ballots on Gnosis Chain: proposals, voter flow, keeper operations and AMB helpers",
  "license": "LGPL-3.0-only",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "gen:abi": "node scripts/gen-abi.mjs"
  },
  "dependencies": {
    "@crisp-e3/sdk": "workspace:*",
    "viem": "2.38.6"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vitest": "^1.6.1"
  }
}
